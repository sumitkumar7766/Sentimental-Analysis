# OpenRouter API Credentials
# Replace with your OpenRouter API key (sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Free Models (Active Free Models on OpenRouter)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

OPENROUTER_FALLBACK_MODELS=baidu/ernie-5.5-flash-preview:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# OpenRouter Application Context & Timeout
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Sentiment Analysis Platform
OPENROUTER_TIMEOUT=15.0
